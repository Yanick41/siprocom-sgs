# SIPROCOM SGS — server environment
# Copy to .env and fill in. NEVER commit the real .env.

NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# Neon: use the POOLED connection string here (needed for serverless).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection — used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth -----------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-generate-a-long-random-value"
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=sgs_token
BCRYPT_ROUNDS=10

# --- CORS -----------------------------------------------------------------
# Comma-separated allowlist of frontend origins.
CLIENT_URL=http://localhost:5173

# --- Logging --------------------------------------------------------------
LOG_LEVEL=debug

# --- Alerts / email (Phase 5) --------------------------------------------
RESEND_API_KEY=
MAIL_FROM="SIPROCOM SGS <noreply@siprocom.local>"

# Shared secret protecting POST /internal/alerts/sweep (Vercel Cron).
CRON_SECRET=

# --- Localisation ---------------------------------------------------------
DEFAULT_LOCALE=fr
