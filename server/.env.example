# SIPROCOM SGS — server environment
#
# Copy to .env for local development. NEVER commit a filled-in .env, and never
# reuse a development secret in production.
#
# Legend:
#   [YOU]      you must supply this — a secret you generate or a provider gives you
#   [PLATFORM] the hosting platform injects it automatically; do not set it by hand
#   [DEFAULT]  safe to leave as-is unless you have a reason
#
# ---------------------------------------------------------------------------

# [PLATFORM] Vercel/Render/Docker set this. Locally: development.
NODE_ENV=development

# [PLATFORM] The host assigns the port. Ignored on serverless.
PORT=4000

# --- Database --------------------------------------------------------------
# [YOU] Required. Boot fails without it.
#
# Local development (PostgreSQL on this machine):
DATABASE_URL="postgresql://postgres:<YOUR_PASSWORD>@localhost:5432/siprocom_sgs?schema=public"
DIRECT_URL="postgresql://postgres:<YOUR_PASSWORD>@localhost:5432/siprocom_sgs?schema=public"
#
# Production on Neon — the two differ and both are needed:
#   DATABASE_URL  the POOLED string (…-pooler.…) — used by the running app
#   DIRECT_URL    the DIRECT string — used by `prisma migrate deploy`, which
#                 cannot run through a connection pooler
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/sgs?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/sgs?sslmode=require"

# --- Auth ------------------------------------------------------------------
# [YOU] Required in production; boot fails if missing.
# Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs every user out immediately.
JWT_SECRET=""

# [DEFAULT]
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=sgs_token
# [DEFAULT] 10 is the sensible floor. 12+ costs noticeable login latency.
BCRYPT_ROUNDS=10

# --- CORS ------------------------------------------------------------------
# [YOU] Required in production. Comma-separated allowlist of front-end origins.
#
# Production boot refuses a localhost origin or a plain-http one: the auth
# cookie is Secure, so http would silently never send it.
# Development additionally accepts any loopback origin, so the port Vite lands
# on does not matter locally.
#
# It also decides where password-reset links point. Set it to the deployed
# domain in production; leave it on localhost while testing, or every link an
# administrator copies will send the colleague to the wrong site.
CLIENT_URL=http://localhost:5280

# --- Logging ---------------------------------------------------------------
# [DEFAULT] info in production, debug locally.
LOG_LEVEL=debug

# --- Scheduled alert sweep -------------------------------------------------
# [YOU] Choose one of the two, never both:
#
#   Single instance (Docker, VPS):  ENABLE_SCHEDULER=true
#     The in-process cron runs the sweep daily at 06:00.
#
#   Serverless / multi-instance (Vercel):  ENABLE_SCHEDULER=false
#     Every instance would otherwise run the same sweep at the same minute.
#     Drive POST /api/alerts/sweep from the platform scheduler instead, sending
#     the CRON_SECRET below in the x-cron-secret header.
ENABLE_SCHEDULER=false
TZ=Africa/Abidjan

# [YOU] Shared secret protecting POST /api/alerts/sweep.
# Empty means the endpoint rejects every call — safe, but the sweep never runs.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Localisation ----------------------------------------------------------
# [DEFAULT]
DEFAULT_LOCALE=fr
