// SIPROCOM SGS — data model
// Reference: IMPLEMENTATION_PLAN.md §5. Business rules enforced on top: §6.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  /// Migrations must not go through a connection pooler: PgBouncer in
  /// transaction mode rejects the session-level statements DDL needs. On Neon,
  /// DATABASE_URL is the pooled endpoint and DIRECT_URL the direct one.
  /// Locally both point at the same database, so this is inert.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  ADMIN
  MAGASINIER
  ACHATS
  DIRECTION
}

/// How a quantity was entered on a document line. Stock is always stored in the
/// product's base unit; this records what the operator actually typed.
enum Packaging {
  UNIT
  CARTON
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum DocStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum EntryReason {
  PURCHASE
  RETURN_CUSTOMER
  ADJUSTMENT
  TRANSFER_IN
}

enum IssueReason {
  SALE
  TRANSFER
  DAMAGE
  SAMPLE
  INTERNAL
  RETURN_SUPPLIER
  OTHER
}

enum AlertType {
  MIN_THRESHOLD
  MAX_THRESHOLD
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// ---------------------------------------------------------------- identity

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String // bcrypt hash — never returned by the API
  role        Role      @default(MAGASINIER)
  isActive    Boolean   @default(true)
  locale      String    @default("fr") // "fr" | "en" — follows the user across devices
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  movements         StockMovement[]
  auditLogs         AuditLog[]
  createdReceipts   GoodsReceipt[]  @relation("ReceiptCreatedBy")
  validatedReceipts GoodsReceipt[]  @relation("ReceiptValidatedBy")
  createdIssues     GoodsIssue[]    @relation("IssueCreatedBy")
  validatedIssues   GoodsIssue[]    @relation("IssueValidatedBy")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------- reference data

model Category {
  id          String  @id @default(uuid())
  name        String
  nameEn      String?
  description String?
  parentId    String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([name, parentId])
  @@index([parentId])
  @@map("categories")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductSupplier[]
  receipts GoodsReceipt[]

  @@index([isActive])
  @@map("suppliers")
}

model Warehouse {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  address     String?
  managerName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockLevels    StockLevel[]
  movements      StockMovement[]
  receipts       GoodsReceipt[]
  issues         GoodsIssue[]    @relation("IssueSourceWarehouse")
  incomingIssues GoodsIssue[]    @relation("IssueDestWarehouse")
  alerts         Alert[]

  @@index([isActive])
  @@map("warehouses")
}

model Product {
  id            String  @id @default(uuid())
  reference     String  @unique
  designation   String
  designationEn String?
  barcode       String? @unique
  categoryId    String

  /// The BASE unit — bottle, kilo, piece. Stock levels, thresholds, alerts and
  /// the movement ledger are all expressed in this unit and nothing else.
  unit String @default("unit")

  /// Physical container, independent of both the category and the counting
  /// unit: a Boisson énergétique exists as a can and as a carton of cans, and a
  /// water as glass or plastic. Kept separate from  because that one is
  /// what stock is counted in — this one only describes the packaging.
  container String?

  /// Which grouping the factor below refers to: carton, crate, pack. Null when
  /// the product is only sold by the unit.
  groupingUnit String?

  /// Purchase price for one full group. Buying by the carton is usually cheaper
  /// per unit than buying loose, so it cannot be derived from buyPrice.
  cartonBuyPrice Decimal? @db.Decimal(12, 2)

  /// Bottles per carton. Null means the product is never sold by the carton.
  /// Used only to convert what an operator types into base units; stock itself
  /// never holds cartons.
  unitsPerCarton Int?

  /// Thresholds are in base units, so an alert means "fewer than N bottles"
  /// regardless of how the goods were received.
  minThreshold Int  @default(0)
  maxThreshold Int?

  buyPrice        Decimal  @default(0) @db.Decimal(12, 2)
  /// Price for ONE base unit.
  sellPrice       Decimal  @default(0) @db.Decimal(12, 2)
  /// Price for one full carton. Entered explicitly rather than derived, so a
  /// wholesale rate is never silently overwritten by a unit-price change.
  cartonSellPrice Decimal? @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category     Category           @relation(fields: [categoryId], references: [id])
  suppliers    ProductSupplier[]
  stockLevels  StockLevel[]
  movements    StockMovement[]
  alerts       Alert[]
  receiptLines GoodsReceiptLine[]
  issueLines   GoodsIssueLine[]

  @@index([categoryId])
  @@index([isActive])
  @@index([designation])
  @@map("products")
}

model ProductSupplier {
  productId         String
  supplierId        String
  supplierRef       String?
  lastPurchasePrice Decimal? @db.Decimal(12, 2)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@index([supplierId])
  @@map("product_suppliers")
}

// ---------------------------------------------------------------- stock core

/// Materialised stock level — the "Stock (vue calculée)" of the cahier des charges §6.
/// Kept as a real table so reads stay fast; updated atomically inside the same
/// transaction as the movement that causes it (BR-2).
/// Invariant: quantity == SUM(signed movements) for the same (product, warehouse).
/// `GET /api/stock/reconcile` proves the invariant against the ledger.
model StockLevel {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_levels")
}

/// Append-only ledger. Never UPDATE, never DELETE (BR-4).
/// Corrections are new compensating movements.
model StockMovement {
  id           String       @id @default(uuid())
  type         MovementType
  productId    String
  warehouseId  String
  /// IN and OUT are always positive — `type` carries the sign.
  /// ADJUSTMENT is SIGNED: positive for a surplus found at inventory, negative
  /// for shrinkage. The ledger sum is therefore always:
  ///   SUM(CASE WHEN type = 'OUT' THEN -quantity ELSE quantity END)
  quantity     Int
  balanceAfter Int // stock snapshot after this movement — makes audits trivial
  unitCost     Decimal?     @db.Decimal(12, 2)
  lotNumber    String?
  reason       String?
  refType      String? // "GoodsReceipt" | "GoodsIssue" | "Adjustment"
  refId        String?
  userId       String
  createdAt    DateTime     @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([productId, createdAt]) // drives trend / rotation queries
  @@index([warehouseId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------- documents

/// Bon d'entrée
model GoodsReceipt {
  id               String      @id @default(uuid())
  number           String      @unique // BE-2026-0001
  supplierId       String?
  warehouseId      String
  reason           EntryReason @default(PURCHASE)
  purchaseOrderRef String?
  status           DocStatus   @default(DRAFT)
  receiptDate      DateTime    @default(now())
  validatedAt      DateTime?
  validatedById    String?
  notes            String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  supplier    Supplier?          @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy   User               @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  validatedBy User?              @relation("ReceiptValidatedBy", fields: [validatedById], references: [id])
  lines       GoodsReceiptLine[]

  @@index([status, receiptDate])
  @@index([supplierId])
  @@index([warehouseId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id           String    @id @default(uuid())
  receiptId    String
  productId    String
  /// Quantity as entered, in  units: 3 means 3 cartons.
  quantity     Int
  packaging    Packaging @default(UNIT)
  /// What actually moves in stock, in base units: 3 cartons of 12 -> 36.
  /// Stored rather than recomputed — changing unitsPerCarton later must not
  /// rewrite the history of documents already posted.
  baseQuantity Int       @default(0)
  /// Price for one  unit at the time of the receipt.
  unitPrice    Decimal   @default(0) @db.Decimal(12, 2)
  lotNumber    String?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
  @@map("goods_receipt_lines")
}

/// Bon de sortie
model GoodsIssue {
  id               String      @id @default(uuid())
  number           String      @unique // BS-2026-0001
  warehouseId      String
  reason           IssueReason @default(SALE)
  /// Customer identification. Kept as plain columns on the document rather than
  /// a Customer table: a shop sells to walk-ins as often as to regulars, and a
  /// required relation would force a record for every one of them.
  recipient        String?
  recipientPhone   String?
  recipientAddress String?
  destWarehouseId  String? // set when reason = TRANSFER (BR-7)
  status           DocStatus   @default(DRAFT)
  issueDate        DateTime    @default(now())
  validatedAt      DateTime?
  validatedById    String?
  notes            String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  warehouse     Warehouse        @relation("IssueSourceWarehouse", fields: [warehouseId], references: [id])
  destWarehouse Warehouse?       @relation("IssueDestWarehouse", fields: [destWarehouseId], references: [id])
  createdBy     User             @relation("IssueCreatedBy", fields: [createdById], references: [id])
  validatedBy   User?            @relation("IssueValidatedBy", fields: [validatedById], references: [id])
  lines         GoodsIssueLine[]

  @@index([status, issueDate])
  @@index([warehouseId])
  @@map("goods_issues")
}

model GoodsIssueLine {
  id           String    @id @default(uuid())
  issueId      String
  productId    String
  /// Quantity as entered, in  units.
  quantity     Int
  packaging    Packaging @default(UNIT)
  /// What actually leaves stock, in base units.
  baseQuantity Int       @default(0)
  /// Unit price frozen when the issue was created, so an invoice reprinted a
  /// year later shows what was billed, not today's price list.
  unitPrice    Decimal   @default(0) @db.Decimal(12, 2)

  issue   GoodsIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([issueId])
  @@index([productId])
  @@map("goods_issue_lines")
}

// ---------------------------------------------------------------- alerts & audit

model Alert {
  id                String      @id @default(uuid())
  productId         String
  warehouseId       String?
  type              AlertType
  status            AlertStatus @default(OPEN)
  quantityAtTrigger Int
  thresholdValue    Int
  createdAt         DateTime    @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([status, type])
  @@index([productId, warehouseId, type, status]) // dedupe lookup (BR-8)
  @@map("alerts")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // LOGIN, VALIDATE_ISSUE, ADJUST_STOCK, ...
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Gapless, race-safe document numbering (BR-10).
/// Allocated with an atomic increment inside the same transaction as the document.
model Counter {
  key   String @id // "BE-2026" | "BS-2026"
  value Int    @default(0)

  @@map("counters")
}
