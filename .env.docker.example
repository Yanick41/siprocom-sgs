# SIPROCOM SGS — self-hosted deployment (docker compose).
# Copy to .env, fill every value, and never commit the result.

# --- Database -------------------------------------------------------------
POSTGRES_USER=siprocom
POSTGRES_DB=siprocom_sgs
# Generate:  openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Auth -----------------------------------------------------------------
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates every active session — users are signed out.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Networking -----------------------------------------------------------
WEB_PORT=8080
API_PORT=4000
# Public URL of the web client. Must match how users actually reach it,
# or CORS will reject the browser's requests.
CLIENT_URL=http://localhost:8080
# Leave as /api: nginx proxies to the API on the same origin, which keeps the
# auth cookie SameSite=Lax.
VITE_API_URL=/api

# --- Runtime --------------------------------------------------------------
LOG_LEVEL=info
TZ=Africa/Abidjan
