# SIPROCOM SGS — client environment
# Copy to .env.local for local overrides. Vite only exposes VITE_* to the browser —
# never put a secret here, it ends up in the bundle.

# Leave empty in development: vite.config.js proxies /api to the server.
# In production set the deployed API origin, e.g. https://sgs-api.siprocom.com/api
VITE_API_URL=
