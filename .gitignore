# Dependencies
node_modules/
.pnp
.pnp.js

# ---------------------------------------------------------------------------
# Secrets - nothing below may ever reach a remote.
#
# Broad on purpose: `.env` alone would not have covered `.env.neon.local`, and
# the pattern that is missing is always the one that leaks. `.gitignore` only
# stops the next commit, so `scripts/check-secrets.js` runs on pre-commit as
# the real guard.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
!**/public*.pem

# Build output
dist/
build/
.vite/

# Prisma
prisma/*.db
prisma/*.db-journal

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Deploy
.vercel/

# Test output
coverage/
playwright-report/
test-results/

# Database dumps - a backup is a full copy of the production data
backups/
*.sql.gz
*.dump

# Scratch
tmp/
*.tmp
